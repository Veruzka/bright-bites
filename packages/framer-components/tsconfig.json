{
  "compilerOptions": {
    "outDir": "dist", // Ensures compiled files go to `dist/`
    "rootDir": "./",  // Start compiling from the root of `framer-components/`
    "declaration": true, // Generates `index.d.ts`
    "module": "ESNext",
    "moduleResolution": "Node",
    "target": "ES6",
    "jsx": "react",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true
  },
  "include": ["index.ts", "src/**/*"]
}

